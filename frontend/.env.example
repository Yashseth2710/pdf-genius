# PDF Genius - frontend environment configuration
# Copy to .env.local for local development. NEVER put secrets in here:
# anything prefixed with NEXT_PUBLIC_ is shipped to the browser.

NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Whether the browser uploads straight to object storage instead of posting
# the file to the API. Leave false locally, where the API takes uploads
# directly and there is no Blob store to write to. Set true on Vercel, whose
# functions refuse any request body over 4.5MB - a third of the smallest file
# a user is allowed to upload.
NEXT_PUBLIC_DIRECT_UPLOADS=false

# Set automatically by Vercel once a Blob store is linked to the project, and
# read only by the route that mints upload tokens. It is not NEXT_PUBLIC_ and
# must never become so: it grants write access to the whole store.
# BLOB_READ_WRITE_TOKEN=
