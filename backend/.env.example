# PDF Genius - backend environment configuration
# Copy to .env and fill in real values. NEVER commit .env.

# --- Database -----------------------------------------------------------
# SQLAlchemy 2.x + psycopg 3 requires the "postgresql+psycopg://" scheme.
# Use the DIRECT Neon endpoint (host WITHOUT "-pooler") for the app and for
# Alembic migrations: uvicorn is long-running and SQLAlchemy keeps its own
# connection pool, so PgBouncer adds nothing and complicates prepared
# statements / migration DDL.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Optional. A SEPARATE, disposable database used by the integration tests,
# which run migrations and then roll the schema back. Never point this at a
# database holding real data. Leave it unset and those tests are skipped.
# TEST_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST.REGION.aws.neon.tech/pdf_genius_test?sslmode=require

# --- Auth ---------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS ---------------------------------------------------------------
# Comma-separated list of allowed frontend origins. No wildcards in production.
CORS_ORIGINS=http://localhost:3000

# --- Rate limits --------------------------------------------------------
# Defaults suit real users. Raise them for automated test runs, which
# legitimately register many accounts from one address.
RATE_LIMIT_REGISTER=5/minute
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_UPLOAD=30/minute
# Processing is CPU work rather than a database read.
RATE_LIMIT_PROCESSING=20/minute

# --- Storage ------------------------------------------------------------
STORAGE_PROVIDER=local
STORAGE_ROOT=./storage
MAX_UPLOAD_SIZE_MB=25
ALLOWED_UPLOAD_TYPES=application/pdf,image/jpeg,image/png

# --- Processing limits --------------------------------------------------
# PyMuPDF works in memory, so these are what stand between a free-tier host
# and an out-of-memory kill. Lower them on a smaller machine.
MAX_MERGE_FILES=20
MAX_MERGE_TOTAL_MB=100
MAX_SPLIT_OUTPUTS=100

# --- File retention (see spec section 50) -------------------------------
# 0 disables automatic expiry; temp files are always cleaned after processing.
OUTPUT_RETENTION_HOURS=24

# --- AI (see spec sections 34/68 - AI is optional, never required) ------
# When unset or unreachable, PDF tools keep working and AI features report
# an unavailable state.
AI_PROVIDER=none
AI_MODEL=

# --- App ----------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
