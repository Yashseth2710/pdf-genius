# PDF Genius - backend environment configuration
# Copy to .env and fill in real values. NEVER commit .env.

# --- Database -----------------------------------------------------------
# SQLAlchemy 2.x + psycopg 3 requires the "postgresql+psycopg://" scheme.
# Use the DIRECT Neon endpoint (host WITHOUT "-pooler") for the app and for
# Alembic migrations: uvicorn is long-running and SQLAlchemy keeps its own
# connection pool, so PgBouncer adds nothing and complicates prepared
# statements / migration DDL.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# --- Auth ---------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS ---------------------------------------------------------------
# Comma-separated list of allowed frontend origins. No wildcards in production.
CORS_ORIGINS=http://localhost:3000

# --- Storage ------------------------------------------------------------
STORAGE_PROVIDER=local
STORAGE_ROOT=./storage
MAX_UPLOAD_SIZE_MB=25
ALLOWED_UPLOAD_TYPES=application/pdf,image/jpeg,image/png

# --- File retention (see spec section 50) -------------------------------
# 0 disables automatic expiry; temp files are always cleaned after processing.
OUTPUT_RETENTION_HOURS=24

# --- AI (see spec sections 34/68 - AI is optional, never required) ------
# When unset or unreachable, PDF tools keep working and AI features report
# an unavailable state.
AI_PROVIDER=none
AI_MODEL=

# --- App ----------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
