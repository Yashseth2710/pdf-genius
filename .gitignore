# --- Dependencies ---
node_modules/
.venv/
venv/
__pycache__/
*.py[cod]

# --- Build output ---
.next/
out/
build/
dist/
*.egg-info/

# --- Environment / secrets ---
.env
.env.*
!.env.example

# --- Testing ---
coverage/
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/
test-results/
playwright-report/
blob-report/

# --- Runtime storage (uploaded / processed / temp files) ---
# Anchored to the backend root on purpose. A bare "storage/" also matches
# app/services/storage/, which silently kept the storage package out of a
# commit and broke CI while every local run passed.
/backend/storage/
/backend/uploads/
/backend/tmp/

# --- Editor / OS ---
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# --- Next.js / Vercel ---
.vercel
next-env.d.ts
*.tsbuildinfo

# --- impeccable (design tooling) ---
# Installed with `npx impeccable install`, not part of the app. Kept on disk
# and out of git: 3.3 MB of third-party tooling in the history buys nothing
# that reinstalling does not.
.impeccable/
.github/skills/impeccable/
.github/agents/impeccable-*
.github/hooks/impeccable.json

# --- Agent config ---
# Claude Code's pointer file. Local tooling, not part of the project.
CLAUDE.md
.claude/
