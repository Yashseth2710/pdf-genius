# Normalise line endings: LF in the repository, native in the working copy.
* text=auto eol=lf

# Binary assets - never normalise or diff as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary

# Generated files - collapse in pull request diffs.
package-lock.json linguist-generated=true
requirements.lock.txt linguist-generated=true
