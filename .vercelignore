# What the deployment upload should never walk.
#
# The build installs dependencies itself, so shipping a local virtualenv or
# node_modules is pure upload time - and on Windows those trees contain files
# held open by whatever is running, which fails the upload outright rather
# than being skipped.
node_modules/
.venv/
__pycache__/
*.pyc

# Local state that is not part of the application.
backend/storage/
frontend/test-results/
frontend/playwright-report/
frontend/.next/
frontend/tsconfig.tsbuildinfo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Never upload environment files. Vercel supplies its own.
.env
.env.*
